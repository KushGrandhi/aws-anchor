# Copy to .env (scripts/gen-env.sh does this and fills the secrets for you).
# Never commit .env.

# Keys clients use to call the gateway (comma-separated). Never leave empty:
# an empty list makes the gateway accept unauthenticated requests.
GATEWAY_API_KEYS=gw-personal-key,gw-webui-key
WEBUI_GATEWAY_KEY=gw-webui-key
WEBUI_SECRET_KEY=change-me

# Provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Aurora (scripts/gen-env.sh fills the secret and invite; scripts/expose.sh fills the public URL)
AURORA_SECRET=change-me
AURORA_INVITE=change-me
AURORA_PUBLIC_URL=
# Optional: aurora on its own domain (see README). The A record points at the static IP; PRIVATE_IP is the
# instance's private address (Lightsail console, or: hostname -I | cut -d" " -f1).
AURORA_DOMAIN=
PRIVATE_IP=
AURORA_VERSION=v0.9.1
