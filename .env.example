# Copy to .env (scripts/gen-env.sh does this and fills the secrets for you).
# Never commit .env.

# Keys clients use to call the gateway (comma-separated). Never leave empty:
# an empty list makes the gateway accept unauthenticated requests.
GATEWAY_API_KEYS=gw-personal-key,gw-webui-key
WEBUI_GATEWAY_KEY=gw-webui-key
WEBUI_SECRET_KEY=change-me

# Provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
